{
  "name": "@resto/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
    "start": "node --env-file=../../.env --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file=../../.env --import tsx src/infrastructure/db/seed.ts",
    "db:history": "node --env-file=../../.env --import tsx src/infrastructure/db/seed-history.ts",
    "db:test:prepare": "node --env-file=../../.env --import tsx src/infrastructure/db/prepare-test-database.ts",
    "db:reset": "node --env-file=../../.env --import tsx src/infrastructure/db/reset.ts && node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs migrate && node --env-file=../../.env --import tsx src/infrastructure/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/jwt": "10.2.4",
    "@fastify/rate-limit": "11.2.1",
    "@resto/shared": "workspace:*",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "postgres": "3.4.9",
    "socket.io": "4.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.1",
    "tsx": "4.23.15"
  }
}
