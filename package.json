{
  "name": "resto-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @resto/hub db:generate",
    "db:migrate": "pnpm --filter @resto/hub db:migrate",
    "db:seed": "pnpm --filter @resto/hub db:seed",
    "db:test:prepare": "pnpm --filter @resto/hub db:test:prepare",
    "db:reset": "pnpm --filter @resto/hub db:reset",
    "fake-printers": "pnpm --filter @resto/hub exec tsx ../../tools/fake-printer/server.ts",
    "demo:flow": "pnpm --filter @resto/hub exec tsx ../../tools/demo-flow.ts",
    "seed:history": "pnpm --filter @resto/hub db:history",
    "dev:info": "pnpm --filter @resto/hub exec tsx ../../tools/dev-info.ts",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
